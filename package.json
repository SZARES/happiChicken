{
  "name": "happy-chicken-landing",
  "version": "1.0.0",
  "description": "Happy Chicken — Fast-food landing page and web ordering platform",
  "main": "src/js/main.js",
  "scripts": {
    "lint": "npm run lint:format && npm run lint:html && npm run lint:js",
    "lint:format": "prettier --check \"**/*.{html,css,js,json,md}\"",
    "lint:html": "htmlhint \"**/*.html\"",
    "lint:js": "eslint .",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "keywords": [
    "happy-chicken",
    "ordering-app",
    "landing-page",
    "utp"
  ],
  "author": "Happy Chicken Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "htmlhint": "^1.1.4",
    "prettier": "^3.3.3"
  },
  "type": "module"
}
